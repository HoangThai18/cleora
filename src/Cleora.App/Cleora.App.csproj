<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Cleora</AssemblyName>
    <RootNamespace>Cleora.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cleora.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\Cleora.Core\Cleora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Cleora.Core\Polyfills.cs" Link="Polyfills.cs" />
    <EmbeddedResource Include="Assets\cleora.ico" LogicalName="Cleora.App.Assets.cleora.ico" />
    <EmbeddedResource Include="Assets\cleora-256.png" LogicalName="Cleora.App.Assets.cleora-256.png" />
  </ItemGroup>

</Project>
